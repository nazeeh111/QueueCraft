include README.md LICENSE Makefile
recursive-include include *.hpp
recursive-include native *.cpp
recursive-include src *.cpp
recursive-include queuecraft *.py *.typed *.sql *.json
recursive-include tests *.py *.cpp *.csv
recursive-include examples *.py *.cpp *.csv *.json *.md *.html
recursive-include docs *.md *.svg *.mmd *.json *.cast
recursive-include sql *.sql
recursive-include tools *.py *.sh *.cpp
recursive-include evidence *.json *.md
global-exclude __pycache__ *.py[cod] *.so *.dylib

include data/README.md
recursive-include data/raw *.parquet *.json *.md
recursive-include data/15m-archive *.parquet *.json *.md

# Keep task-local preparation and obsolete release packets outside distributions.
prune evidence/local-tools
prune evidence/local-release
prune evidence/local-prior-demo
prune evidence/prospective-study-v1
prune evidence/completion-installed-consumer-v3

include evidence/completion-study-review.py
